# =========================================================
# AgroFlow Agri-OS Production Environment Configuration
# =========================================================

# 1. Core Server & Security
NODE_ENV="production"
PORT=3000
JWT_SECRET="your-high-entropy-64-character-jwt-secret-key"
APP_URL="https://agroflow.co.ke"

# 2. Database Connection (PostgreSQL / Neon / Turso libSQL)
# For local development, defaults to data/agroflow.db
DATABASE_URL="postgresql://user:password@ep-sample-12345.neon.tech/agroflow?sslmode=require"

# 3. Safaricom M-Pesa Daraja 2.0 API (Production / Sandbox)
DARAJA_ENVIRONMENT="sandbox" # or "production"
DARAJA_CONSUMER_KEY="your-safaricom-daraja-consumer-key"
DARAJA_CONSUMER_SECRET="your-safaricom-daraja-consumer-secret"
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY="your-daraja-lipa-na-mpesa-online-passkey"
DARAJA_CALLBACK_URL="https://agroflow.co.ke/api/payments/mpesa/callback"

# 4. Africa's Talking SMS Gateway
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_SENDER_ID="AGROFLOW"

# 5. Distributed Cache & Rate Limiter (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"
